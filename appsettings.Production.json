{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_SERVER;Database=GymManagementDB;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true;Connection Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer":    "GymManagementAPI",
    "Audience":  "GymManagementClient",
    "ExpiryMinutes": 480
  },
  "Email": {
    "Enabled": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "YOUR_GMAIL_ADDRESS@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "FromEmail": "YOUR_GMAIL_ADDRESS@gmail.com",
    "FromName": "GymPro",
    "OtpExpiresMinutes": 5
  },
  "Khqr": {
    "BakongAccountId": "YOUR_BAKONG_ACCOUNT_ID",
    "MerchantName": "GymPro",
    "MerchantCity": "Phnom Penh",
    "CountryCode": "KH",
    "MerchantCategoryCode": "7997",
    "DefaultCurrency": "USD",
    "PaymentExpiresMinutes": 10,
    "ApiBaseUrl": "https://YOUR_BAKONG_OPEN_API_BASE_URL",
    "ApiToken": "YOUR_BAKONG_OPEN_API_TOKEN"
  },
  "CorsOrigins": [
    "https://YOUR_PRODUCTION_DOMAIN.com"
  ],
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "GeneralRules": [
      { "Endpoint": "POST:/api/auth/login",      "Period": "15m", "Limit": 10 },
      { "Endpoint": "POST:/api/auth/verify-otp", "Period": "15m", "Limit": 20 },
      { "Endpoint": "POST:/api/public/register", "Period": "15m", "Limit": 5 },
      { "Endpoint": "*",                    "Period": "1m",  "Limit": 200 }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": { "Microsoft": "Error" }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/gym-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "YOUR_PRODUCTION_DOMAIN.com"
}
