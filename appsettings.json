{
  "Urls": "http://localhost:5000;http://0.0.0.0:5000",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=GymManagementDB;User Id=sa;Password=admin;TrustServerCertificate=True;MultipleActiveResultSets=true;Connection Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "GymProSuperSecretKey2024!@#$%^&*()",
    "Issuer": "GymManagementAPI",
    "Audience": "GymManagementClient",
    "ExpiryMinutes": 480
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "GymPro",
    "OtpExpiresMinutes": 5
  },
  "Khqr": {
    "BakongAccountId": "merchant@bakong",
    "MerchantName": "GymPro",
    "MerchantCity": "Phnom Penh",
    "CountryCode": "KH",
    "MerchantCategoryCode": "7997",
    "DefaultCurrency": "USD",
    "PaymentExpiresMinutes": 10,
    "ApiBaseUrl": "",
    "ApiToken": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "15m",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/auth/verify-otp",
        "Period": "15m",
        "Limit": 30
      },
      {
        "Endpoint": "POST:/api/public/register",
        "Period": "15m",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 300
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gym-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "CorsOrigins": [
    "http://localhost:5000",
    "http://localhost:5500",
    "http://localhost:3000"
  ]
}
